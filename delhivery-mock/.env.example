# Copy to .env.local for `vercel dev`, or export in your shell for `npm start`.
# On Vercel set these under Project -> Settings -> Environment Variables.

# Shared secret the connector must send as:  Authorization: Token <value>
# Leave empty to disable auth (local only). Generate one with:  openssl rand -hex 24
MOCK_API_TOKEN=

# Also accept "Authorization: Bearer <token>" and "X-API-Key: <token>" (if your connector cannot send "Token ...").
MOCK_ACCEPT_ALT_AUTH=false

# Server-wide default scenario (normal | no_rider | timeout | malformed | ...). Per-request header/path wins.
MOCK_SCENARIO=normal

# Delay for the `timeout` scenario in ms (max 55000). AgenticOrg's default connector timeout appeared as 10000 ms.
MOCK_TIMEOUT_MS=15000

# Include the `_mock` metadata object in JSON responses (honest labelling of synthetic failures).
MOCK_INCLUDE_META=true

# Require the documented "format=json&data=" wrapper on /api/cmu/create.json (real Delhivery behaviour).
MOCK_STRICT_FORMAT=false

# Optional: comma-separated registered warehouse names; others get "ClientWarehouse matching query does not exist."
MOCK_WAREHOUSE_NAMES=

# Optional: registered client name; a different `client` field gets "shipment list contains no data".
MOCK_CLIENT_NAME=

# Pincodes not in the mock dataset: serviceable | nsz
MOCK_UNKNOWN_PINCODES=serviceable

# Auto-advance tracking stages every N seconds after creation (0 = off). E.g. 60 for a live WAIT demo.
MOCK_PROGRESS_SECONDS=0

# Fixed clock for deterministic runs (ISO-8601), e.g. 2026-10-04T06:30:00Z. Empty = real clock.
MOCK_FIXED_NOW=

# debug | info | warn | error | silent
MOCK_LOG_LEVEL=info
